---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
}

const { src, alt, caption, width = 500 } = Astro.props;
---

<figure>
  <button type="button" class="figure-zoom" aria-label="Agrandir l'image">
    <Image src={src} alt={alt} width={width} />
  </button>
  {caption && <figcaption>{caption}</figcaption>}
  <dialog class="figure-dialog" aria-label="Image en grand">
    <img src={src.src} alt={alt} />
  </dialog>
</figure>

<style>
  figure {
    margin: 1.5rem auto;
    text-align: center;
  }
  .figure-zoom {
    display: inline-block;
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }
  .figure-zoom:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  figure :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: #666;
    font-style: italic;
  }
  .figure-dialog {
    border: none;
    background: transparent;
    padding: 0;
    max-width: 95vw;
    max-height: 95vh;
  }
  .figure-dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.85);
  }
  .figure-dialog img {
    display: block;
    max-width: 95vw;
    max-height: 95vh;
    width: auto;
    height: auto;
    cursor: zoom-out;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.figure-zoom').forEach((btn) => {
    const figure = btn.closest('figure');
    const dialog = figure?.querySelector<HTMLDialogElement>('.figure-dialog');
    if (!dialog) return;
    btn.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('click', () => dialog.close());
  });
</script>
